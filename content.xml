<text:p text:style-name="Code">Command:</text:p>
<text:p text:style-name="Code">$ ./trading-bot backtest \</text:p>
<text:p text:style-name="Code">    --symbol XAUUSD \</text:p>
<text:p text:style-name="Code">    --timeframe-1h H1 \</text:p>
<text:p text:style-name="Code">    --timeframe-entry M1 \</text:p>
<text:p text:style-name="Code">    --days 30</text:p>
<text:p/>
<text:p text:style-name="Code">What it does:</text:p>
<text:list>
<text:list-item><text:p>✅ Uses 1-hour candles for S/R detection</text:p></text:list-item>
