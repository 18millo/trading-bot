<!-- Slide 4: ENB Strategy Explained -->
<draw:page draw:name="Slide4" draw:style-name="dp4" presentation:presentation-page-layout-name="pr4">
<draw:frame draw:layer="layout" presentation:placeholder="true" svg:width="25cm" svg:height="3cm" svg:x="6cm" svg:y="2cm">
<draw:text-box>
<text:h text:style-name="Title">
<text:p>ENB STRATEGY - HOW IT WORKS</text:p>
</text:h>
</draw:text-box>
</draw:frame>
<draw:frame draw:layer="layout" svg:width="28cm" svg:height="15cm" svg:x="4cm" svg:y="5cm">
<draw:text-box>
<text:list>
<text:list-item><text:p><text:span>1. MARKET STRUCTURE (1-minute)</text:span></text:p></text:list-item>
<text:list-item><text:p>   ✓ Higher Highs/Higher Lows = BULLISH</text:p></text:list-item>
<text:list-item><text:p>   ✓ Lower Highs/Lower Lows = BEARISH</text:p></text:list-item>
<text:list-item><text:p><text:span>2. LIQUIDITY SWEEP (1-minute)</text:span></text:p></text:list-item>
<text:list-item><text:p>   ✓ Price sweeps previous highs (sell-side liquidity)</text:p></text:list-item>
<text:list-item><text:p>   ✓ Price sweeps previous lows (buy-side liquidity)</text:p></text:list-item>
<text:list-item><text:p><text:span>3. ENGULFING CANDLE (1-minute entry)</text:span></text:p></text:list-item>
<text:list-item><text:p>   ✓ Strong candle confirmation</text:p></text:list-item>
<text:list-item><text:p>   ✓ Must close above/below previous candle</text:p></text:list-item>
<text:list-item><text:p><text:span>4. SUPPORT/RESISTANCE (1-hour detection)</text:span></text:p></text:list-item>
<text:list-item><text:p>   ✓ Swing highs = Resistance levels</text:p></text:list-item>
<text:list-item><text:p>   ✓ Swing lows = Support levels</text:p></text:list-item>
<text:list-item><text:p>   ✓ Only trade when price is NEAR S/R levels</text:p></text:list-item>
<text:list-item><text:p><text:span>✅ ALL 4 conditions must align = HIGH PROBABILITY</text:span></text:p></text:list-item>
</text:list>
</draw:text-box>
</draw:frame>
</draw:page>

